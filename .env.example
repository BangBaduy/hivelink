# Neon PostgreSQL Serverless Connection String (Username: neondb_owner)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Resend API Configuration
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="no-reply@upvance.site"

# JWT Secret for Session Cookies
JWT_SECRET="replace_with_at_least_32_random_characters"
RATE_LIMIT_SECRET="replace_with_an_independent_32_character_secret"
ANALYTICS_HASH_SECRET="replace_with_an_independent_32_character_secret"

# Production Domain for Short Links & QR Codes
NEXT_PUBLIC_APP_URL="https://hiveuin.tech"
